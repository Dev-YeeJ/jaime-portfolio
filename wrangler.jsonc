/**
 * Cloudflare Workers config for the portfolio.
 *
 * The site is served by the OpenNext adapter, which compiles the real `next build`
 * output into a Worker. That is deliberate: Cloudflare's newer `vinext` path
 * reimplements the Next.js API surface, and its own compatibility check flagged
 * two regressions for this site — Google Fonts loaded from a CDN instead of being
 * self-hosted, and no local image optimization. The hero portrait is the LCP
 * element, so losing image optimization is not an acceptable trade here.
 *
 * `name` must match the Worker that Cloudflare actually created, which Workers
 * Builds names after the repository — `jaime-portfolio`, not the site's domain.
 * It is also the *.workers.dev subdomain and the target of the
 * WORKER_SELF_REFERENCE binding below, so all three move together. Getting this
 * wrong fails only at the deploy step, after a green build, with
 * "Service binding 'WORKER_SELF_REFERENCE' references Worker '<x>' which was not
 * found."
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaime-portfolio",
  "main": ".open-next/worker.js",

  // Matches the installed workerd (1.20260828.1). Do not set this past the
  // runtime's own build date or Wrangler refuses to start.
  "compatibility_date": "2026-08-28",

  // Both are required by the adapter: `nodejs_compat` for Node built-ins used by
  // the Next.js server, `global_fetch_strictly_public` so server-side fetches to
  // this same site go over the public internet rather than looping internally.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jaime-portfolio"
    }
  ],

  "observability": {
    "enabled": true
  }
}
